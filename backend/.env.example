# Point this at an application health endpoint. Keep ALLOW_PRIVATE_TARGETS=false
# for normal use; enable it only when monitoring the loopback test target below.
MONITOR_TARGET_URL=https://your-application.example/health
MONITOR_SERVICE_NAME=Target application
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=15
MONITOR_FAILURE_THRESHOLD=3
MONITOR_TIMEOUT_SECONDS=5
ALLOW_PRIVATE_TARGETS=false
DATABASE_PATH=backend/data/incidents.sqlite3
COMMANDER_API_TOKEN=replace-with-a-long-random-local-token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY_2=your-gemini-api-key-2-here
GEMINI_API_KEY_3=your-gemini-api-key-3-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30